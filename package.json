{
  "name": "brutus-cortes",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.20.0",
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --config vite.config.js --configLoader native --host 127.0.0.1",
    "build": "vite build --config vite.config.js --configLoader native",
    "start": "node server/index.js",
    "job:whatsapp-reminders": "node server/jobs/send-whatsapp-reminders.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/oswald": "^5.2.6",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "luxon": "^3.6.1",
    "mongoose": "^8.16.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
